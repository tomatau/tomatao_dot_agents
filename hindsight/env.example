# Hindsight server environment — canonical template.
# Copy to env.local (gitignored) and adjust. Sourced by the launchd wrapper
# and by the repo-root .envrc for manual runs.

# Localhost binding per docs/memory-strategy.md
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888

# Vault location — machine-local, not shared across hosts. Point this at your
# own Obsidian vault root (an iCloud vault lives under
# ~/Library/Mobile Documents/com~apple~CloudDocs/…).
VAULT_DIR="$HOME/path/to/your/obsidian/vault"

# Extraction LLM via subscription OAuth — no API keys in this file.
# Primary: Claude Pro/Max through the logged-in Claude Code CLI.
# Leave HINDSIGHT_API_LLM_MODEL unset for now; pick a haiku-tier id once
# the first boot shows what the provider resolves.
HINDSIGHT_API_LLM_PROVIDER=claude-code

# Secondary lane for automatic subscription rotation (uncomment when ready):
# HINDSIGHT_API_LLM_1_PROVIDER=openai-codex
# Requires an isolated auth dir so the long-lived server never fights the
# interactive Codex CLI for its refresh token — see Models docs,
# "Isolating Codex auth for long-running services":
# CODEX_HOME=~/.agents/hindsight/codex-home

# Failover across members:
# HINDSIGHT_API_LLM_STRATEGY='{"mode": "failover"}'
